#include <winver.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "../../assets/icon/ChojemaInputLens.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION INPUTLENS_VERSION_MAJOR, INPUTLENS_VERSION_MINOR, INPUTLENS_VERSION_PATCH, 0
PRODUCTVERSION INPUTLENS_VERSION_MAJOR, INPUTLENS_VERSION_MINOR, INPUTLENS_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "Chulwoo Park"
            VALUE "FileDescription", "Chojema InputLens"
            VALUE "FileVersion", INPUTLENS_VERSION_STRING
            VALUE "InternalName", "ChojemaInputLens"
            VALUE "LegalCopyright", "Copyright (c) 2026 Chulwoo Park"
            VALUE "OriginalFilename", "ChojemaInputLens.exe"
            VALUE "ProductName", "Chojema InputLens"
            VALUE "ProductVersion", INPUTLENS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
